{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn-the-algorithm",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "ratelimits": [
    {
      // Per-visitor limit for /api/name
      "name": "NAME_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Global backstop across all visitors, bounds total spend
      "name": "NAME_GLOBAL_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
